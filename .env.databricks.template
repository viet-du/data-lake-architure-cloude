# ═══════════════════════════════════════════════════════════════
# Databricks Environment Template (Community Edition)
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in the values below:
#   cp .env.databricks.template .env
# Then edit .env and set DATABRICKS_TOKEN.
# ═══════════════════════════════════════════════════════════════

# Active environment (databricks | local)
ENV=databricks
LOG_LEVEL=info

# Databricks workspace
DATABRICKS_HOST=https://community.cloud.databricks.com/

# Personal Access Token (generate from User Settings → Developer → Access tokens)
# IMPORTANT: Never commit this token. Keep it in .env (git-ignored).
DATABRICKS_TOKEN=

# Cluster ID is NOT needed for serverless compute.
# If you switch to a traditional cluster later, set:
# DATABRICKS_CLUSTER_ID=

# Delta Lake path prefixes (used by paths.py when ENV=databricks)
DATABRICKS_BRONZE_PATH=dbfs:/lakehouse/bronze
DATABRICKS_SILVER_PATH=dbfs:/lakehouse/silver
DATABRICKS_GOLD_PATH=dbfs:/lakehouse/gold
DATABRICKS_CHECKPOINT_PATH=dbfs:/lakehouse/_checkpoints

# Databricks Unity Catalog (default catalog for Community Edition)
# Community Edition uses <workspace_name> as the default catalog.
# Set this if you want a specific catalog for bronze/silver/gold.
DATABRICKS_CATALOG=workspace
DATABRICKS_BRONZE_SCHEMA=bronze
DATABRICKS_BRONZE_VOLUME=bronze_data
DATABRICKS_CRAWLER_BRONZE_TABLE=crawler_raw

# Set to 1 only for development environments whose TLS proxy certificate is
# not trusted by Python. Keep certificate verification enabled otherwise.
LAKEHOUSE_INSECURE=0

# Delta Lake / Kafka packages (compatible with Databricks runtime)
DELTA_PACKAGE=io.delta:delta-spark_2.12:3.0.0
KAFKA_PACKAGE=org.apache.spark:spark-sql-kafka-0-10_2.12:3.5.6

# Spark
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=2g
SPARK_EXECUTOR_MEMORY=2g

# Data Quality
DQ_MAX_NULL_PERCENT=5.0
DQ_FAIL_ON_ERROR=false

# Crawlers
TIKI_API_BASE=https://tiki.vn/api/v2
CRAWLER_RATE_LIMIT=1.0
CRAWLER_MAX_WORKERS=8
CRAWLER_TIMEOUT=30

# Metabase connection (optional; keep API keys only in ignored local .env)
METABASE_URL=http://localhost:3000
METABASE_API_KEY=
