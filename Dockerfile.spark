# ============================================================================
# Dockerfile.spark  (DEPRECATED — kept for reference only)
# ----------------------------------------------------------------------------
# This image was used by `docker-compose.spark.yml` to override the Bitnami
# Spark base. PHASE 2 removes that override because:
#   - The default `Dockerfile.spark-runtime` (Bitnami spark:3.5.6) ships
#     multi-arch manifests including linux/arm64, so Apple Silicon does
#     NOT need emulation.
#   - This image, built from `apache/spark:3.5.0`, has only the amd64
#     manifest on Docker Hub for the 3.5.0 tag, so on Apple Silicon it
#     would run under QEMU emulation (slower than the Bitnami default).
#
# Do not reference this file from docker-compose. You may still build it
# manually with `docker build -f Dockerfile.spark -t lake-spark:3.5.0 .`
# if you specifically need the apache/spark base.
# ============================================================================

FROM apache/spark:3.5.0

USER root

# Install pip and the lakehouse Python dependencies.
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3-pip \
    && rm -rf /var/lib/apt/lists/*

# Install Python deps matching pyproject.toml dependencies list.
# We install delta-spark pip package (in addition to the JAR provided via
# --packages) so that delta.pip_utils.configure_spark_with_delta_pip works
# from Python 3.8. importlib_metadata >= 5.0 is required by delta-spark 3.0.
RUN pip3 install --no-cache-dir --upgrade pip 2>&1 | tail -2
RUN pip3 install --no-cache-dir \
        "python-dotenv>=1.0" \
        "pyarrow>=14" \
        "pandas>=2.0" \
        "boto3>=1.34" \
        "kafka-python>=2.0" \
        "requests>=2.31" \
        "beautifulsoup4>=4.12" \
        "pydantic>=2.5" \
        "fake-useragent>=1.4" \
        "tenacity>=8.2" \
        "importlib_metadata>=5.0" \
        "delta-spark==3.0.0" 2>&1 | tail -3

# Make Python deps visible to PySpark by extending PYTHONPATH
ENV PYTHONPATH="/app-src/src:/opt/spark/python:/opt/spark/python/lib/py4j-0.10.9.7-src.zip"

WORKDIR /opt/spark
