# ═══════════════════════════════════════════════════════════════
# Data Lake Architecture - Root environment
# Development defaults for local Docker stack
# ═══════════════════════════════════════════════════════════════

# General
ENV=local
LOG_LEVEL=info

# MinIO (S3-compatible storage)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false

# Kafka / Redpanda
KAFKA_BOOTSTRAP=localhost:9192
KAFKA_SECURITY_PROTOCOL=PLAINTEXT

# Spark
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=2g
SPARK_EXECUTOR_MEMORY=2g

# Delta Lake / Kafka packages
DELTA_PACKAGE=io.delta:delta-spark_2.12:3.0.0
KAFKA_PACKAGE=org.apache.spark:spark-sql-kafka-0-10_2.12:3.4.0

# Data Quality
DQ_MAX_NULL_PERCENT=5.0
DQ_FAIL_ON_ERROR=false

# Crawlers
TIKI_API_BASE=https://tiki.vn/api/v2
CRAWLER_RATE_LIMIT=1.0
CRAWLER_MAX_WORKERS=8
CRAWLER_TIMEOUT=30
