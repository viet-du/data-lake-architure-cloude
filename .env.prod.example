# ═══════════════════════════════════════════════════════════════
# Data Lake Architecture — Cloud (R2 + Render.com)
#
# This file is the CLOUD env. Do NOT use it for local dev.
# Local dev uses .env (copied from .env.example).
#
# NEVER commit secrets. This file should be safe to commit because
# it contains placeholders, not real values. Real values live in:
#   - Render dashboard env vars (per-service)
#   - GitHub Actions secrets (for cron jobs)
#   - Local .env (git-ignored, for testing)
# ═══════════════════════════════════════════════════════════════

# ─── General ─────────────────────────────────────────────────
ENV=prod
LOG_LEVEL=info
NODE_ENV=production

# ─── Cloudflare R2 (storage, $0 egress) ──────────────────────
# Get from Cloudflare dashboard right sidebar
R2_ACCOUNT_ID=<32-char-hex>
# Get from R2 → "Manage R2 API Tokens" (one token per consumer)
R2_ACCESS_KEY=<access-key-id>
R2_SECRET_KEY=<secret-access-key>
R2_REGION=auto
R2_USE_SSL=true
R2_PATH_STYLE_ACCESS=true

# Bucket names (must match the ones created with `wrangler r2 bucket create`)
R2_BUCKET_BRONZE=bronze
R2_BUCKET_SILVER=silver
R2_BUCKET_GOLD=gold
R2_BUCKET_SCRIPTS=scripts

# Optional: R2 custom domain (if you have one, for public previews)
# R2_PUBLIC_BASE_URL=https://data-preview.yourdomain.com

# ─── Cloud-side service endpoints (Render) ───────────────────
# Internal DNS for in-cluster services; public URLs for ingress
KAFKA_BOOTSTRAP=lake-kafka:9092  # only if Kafka private service is provisioned
MINIO_ENDPOINT=http://lake-minio:9000  # only if MinIO private service is provisioned
SPARK_MASTER=local[*]  # Render cron jobs run Spark in local mode
AIRFLOW_BASE_URL=  # only if Airflow is also deployed

# Render-managed Postgres (auto-injected as DATABASE_URL when you link the database)
# For cloud-only parity, the explicit form is:
POSTGRES_URL=postgres://lakehouse:<password>@dpg-xxxxx.oregon-postgres.render.com:5432/lakehouse
# Mongo + Redis: provision as separate Render services when needed
MONGO_URL=mongodb://lake-mongo:27017/lakehouse
REDIS_URL=redis://lake-redis:6379/0

# ─── Airflow ────────────────────────────────────────────────
# Generate once: openssl rand -base64 32 | tr '+/' '-_'
# Same value in local .env and cloud (don't change after first run)
AIRFLOW_FERNET_KEY=<base64-string>
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__WEBSERVER__EXPOSE_CONFIG=True
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=<random-32-char-string>

# ─── Data Quality ───────────────────────────────────────────
DQ_MAX_NULL_PERCENT=5.0
DQ_FAIL_ON_ERROR=false

# ─── API (Next.js control plane) ────────────────────────────
# Public URL the Web UI calls (set after first deploy, copy from Render dashboard)
NEXT_PUBLIC_API_BASE_URL=https://lake-api.onrender.com
PORT=3001

# ─── Crawlers ──────────────────────────────────────────────
TIKI_API_BASE=https://tiki.vn/api/v2
CRAWLER_RATE_LIMIT=1.0
CRAWLER_MAX_WORKERS=8
CRAWLER_TIMEOUT=30

# ─── Cost guardrails ───────────────────────────────────────
# Hard cap: alert email is sent when monthly R2 spend exceeds this
R2_BUDGET_ALERT_USD=20
# Hard cap: same for Render (set in dashboard Billing → Alerts)
RENDER_BUDGET_ALERT_USD=20
