services:
  api:
    build:
      context: ./apps/api
      dockerfile: Dockerfile
    container_name: lake-api
    ports:
      - "3001:3001"
    env_file: .env
    environment:
      MONGO_URI: mongodb://mongo:27017
      REDIS_HOST: redis
    depends_on:
      - mongo
      - redis
      - minio
      - redpanda
      - airflow-webserver
    restart: unless-stopped

  web:
    build:
      context: .
      dockerfile: apps/web/Dockerfile
    container_name: lake-web
    ports:
      - "5173:5173"
    environment:
      VITE_API_BASE_URL: http://localhost:3001
    depends_on:
      - api
    restart: unless-stopped

  # Airflow services duplicated from docker-compose.yml so this file
  # can be used standalone (`docker compose -f docker-compose.api.yml up`).
  # If merging with the main compose, these will be ignored automatically.
  airflow-db:
    image: postgres:13
    container_name: lake-airflow-db-api
    environment:
      POSTGRES_DB: airflow
      POSTGRES_USER: airflow
      POSTGRES_PASSWORD: airflow
    volumes:
      - airflow_db_data_api:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U airflow"]
      interval: 10s
      timeout: 5s
      retries: 5

  airflow-webserver:
    # Custom image with lakehouse Python deps pre-installed.
    # Build with:  docker build -f Dockerfile.airflow -t lake-airflow:2.7.0 .
    build:
      context: .
      dockerfile: Dockerfile.airflow
    image: lake-airflow:2.7.0
    container_name: lake-airflow-webserver-api
    depends_on:
      airflow-db:
        condition: service_healthy
    environment:
      AIRFLOW__CORE__EXECUTOR: LocalExecutor
      AIRFLOW__DATABASE__SQL_ALCHEMY_CONN: postgresql+psycopg2://airflow:airflow@airflow-db/airflow
      AIRFLOW__CORE__FERNET_KEY: "W7LcX4pJ9z8V0qK1yN6mE3hG5sF2bA0dR9tQ8uX7vP="
      AIRFLOW__CORE__LOAD_EXAMPLES: "false"
    ports:
      - "8088:8080"
    volumes:
      - ./airflow_dags:/opt/airflow/dags:ro
      - ./src:/opt/airflow/app/src:ro
      # Mount Docker socket so DAG tasks can call `docker exec lake-spark-master spark-submit ...`
      # Note: `/usr/bin/docker` is already present in the base image, so we only need the socket.
      - /var/run/docker.sock:/var/run/docker.sock
    command: >
      bash -c "
      airflow db init &&
      airflow users create --username admin --firstname Admin --lastname User --role Admin --email admin@example.com --password admin;
      airflow webserver
      "

  mongo:
    image: mongo:7
    container_name: lake-mongo
    ports:
      - "27017:27017"
    volumes:
      - mongo_data:/data/db
    restart: unless-stopped

  redis:
    image: redis:7-alpine
    container_name: lake-redis
    ports:
      - "6379:6379"
    volumes:
      - redis_data:/data
    restart: unless-stopped

volumes:
  mongo_data:
  redis_data:
  airflow_db_data_api:
