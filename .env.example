# Databricks credentials — DO NOT COMMIT real values.
# Copy this file to .env and fill in real secrets:
#   cp .env.example .env
#
# Then either:
#   source .env                              # exports into current shell
#   python -m dotenv .env python scripts/.. # auto-load via python-dotenv
#   direnv allow                             # if using direnv

# Workspace URL (Databricks workspace origin)
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com

# Personal Access Token from User Settings → Developer → Access Tokens
DATABRICKS_TOKEN=replace-with-rotated-token

# SQL Warehouse ID (Settings → SQL Warehouses → click warehouse → copy ID)
DATABRICKS_WAREHOUSE_ID=yourwarehouseid

# Airflow crawler landing target (Unity Catalog Volume -> Bronze Delta table)
DATABRICKS_CATALOG=workspace
DATABRICKS_BRONZE_SCHEMA=bronze
DATABRICKS_BRONZE_VOLUME="bronze_data"
DATABRICKS_CRAWLER_BRONZE_TABLE="crawler_raw"

# Optional: All-Purpose Cluster ID (Compute → click cluster → copy ID)
# Only needed if you run scripts/_etl_pipeline.py / _elt_pipeline.py on a cluster
# instead of the SQL warehouse.
DATABRICKS_CLUSTER_ID=""

# Cloudflare R2 (object storage) — for raw_elt backup / cold storage
R2_ENDPOINT_URL="https://<account_id>.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="lakehouse-cold"

ENV=local
LOG_LEVEL=info
# Local PostgreSQL reporting mirror used by Metabase (development only).
GOLD_POSTGRES_USER=metabase
GOLD_POSTGRES_PASSWORD=change-me-local
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
KAFKA_BOOTSTRAP=localhost:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
MONGO_URI=mongodb://localhost:27017
MONGO_DB=lakehouse_catalog
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
AIRFLOW_BASE_URL=http://localhost:8080/api/v1
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=admin
API_PORT=3001
API_RATE_LIMIT_PER_MIN=600
API_CORS_ORIGINS=http://localhost:3000,http://localhost:3001
API_SWAGGER_ENABLED=true
DUCKDB_MEMORY_LIMIT=4GB
DUCKDB_THREADS=4
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=2g
SPARK_EXECUTOR_MEMORY=2g
DELTA_PACKAGE=io.delta:delta-spark_2.12:3.0.0
KAFKA_PACKAGE=org.apache.spark:spark-sql-kafka-0-10_2.12:3.4.0
DQ_MAX_NULL_PERCENT=5.0
DQ_FAIL_ON_ERROR=false
TIKI_API_BASE=https://tiki.vn/api/v2
CRAWLER_RATE_LIMIT=1.0
CRAWLER_MAX_WORKERS=8
CRAWLER_TIMEOUT=30
LAKEHOUSE_DATA_SOURCE=databricks
DATABRICKS_WORKSPACE_ID=0000000000000000
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/yourwarehouseid
DATABRICKS_CATALOG=workspace
DATABRICKS_BRONZE_SCHEMA=bronze
DATABRICKS_SILVER_SCHEMA=silver
DATABRICKS_GOLD_SCHEMA=gold
AIRFLOW_FERNET_KEY=generate-a-fernet-key

# Metabase API access (optional; never commit a real API key)
METABASE_URL=http://localhost:3000
METABASE_API_KEY=
