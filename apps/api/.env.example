ENV=local
LOG_LEVEL=info

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false

# Optional Cloudflare R2 / S3-compatible override.
# Set these instead of MINIO_* on the deployed API. Never set them in the web UI.
#
#   S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   S3_ACCESS_KEY=<R2 access key ID>
#   S3_SECRET_KEY=<R2 secret access key>
#   S3_REGION=auto
#   S3_PATH_STYLE_ACCESS=true
#   S3_USE_SSL=true
#   S3_HEALTH_BUCKET=lakehouse
#
# QUAN TRỌNG: code đọc `S3_*`, KHÔNG đọc `R2_*`. Bucket phải tên `lakehouse`
# (toàn bộ đường dẫn là s3a://lakehouse/{layer}/{db}/{table}).
# S3_PATH_STYLE_ACCESS phải là true — R2 không hỗ trợ virtual-host style.
#
# Canonical bucket chứa toàn bộ 3 tầng medallion (bronze/silver/gold).
LAKEHOUSE_BUCKET=lakehouse

KAFKA_BOOTSTRAP=localhost:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT

# MongoDB bật auth (root: mongoadmin/mongoadmin trong docker-compose.yml).
# Chạy API trên HOST (không trong Docker) thì cần authSource=admin.
# Trong Docker, docker-compose.dev-api.yml override thành ...@mongo:27017.
MONGO_URI=mongodb://mongoadmin:mongoadmin@localhost:27017/?authSource=admin
MONGO_DB=lakehouse_catalog

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

AIRFLOW_BASE_URL=http://localhost:8088/api/v1
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=admin

API_PORT=3001
API_RATE_LIMIT_PER_MIN=600
# API_CORS_ORIGINS phải chứa origin của web. Dev web chạy ở port 5173
# (không phải 3000 — 3000 là Metabase). Nếu thiếu 5173 thì trình duyệt bị
# chặn CORS và mọi request từ UI đều fail.
API_CORS_ORIGINS=http://localhost:5173,http://localhost:3001
API_SWAGGER_ENABLED=true

# ── Authentication ────────────────────────────────────────────────────────
# API_AUTH_ENABLED=true bắt buộc login. Khi đó MongoDB phải có ít nhất một
# user. Trên máy mới (clone lần đầu) MongoDB rỗng → chạy bootstrap:
#
#   export API_BOOTSTRAP_ADMIN_EMAIL="<email-cua-ban>"
#   export API_BOOTSTRAP_ADMIN_PASSWORD="<mat-khau>=<32+ chars>"
#   pnpm --filter lakehouse-api security:bootstrap
#
# Script đọc biến MÔI TRƯỜNG (không đọc file) để secret không nằm trong repo.
# Lưu ý: "add admin" trên GitHub KHÔNG có tác dụng gì với hệ thống này —
# user nằm trong MongoDB collection `control_plane_users` của máy từng người.
API_AUTH_ENABLED=false
# HMAC secret cho session token — tối thiểu 32 ký tự.
# Sinh: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
API_JWT_SECRET=local-development-only-secret-change-me-32ch

DUCKDB_MEMORY_LIMIT=4GB
DUCKDB_THREADS=4

SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=2g
SPARK_EXECUTOR_MEMORY=2g

DELTA_PACKAGE=io.delta:delta-spark_2.12:3.0.0
# Kafka packages (matched to the jar version pinned in Dockerfile.spark-runtime)
KAFKA_PACKAGE=org.apache.spark:spark-sql-kafka-0-10_2.12:3.4.0

DQ_MAX_NULL_PERCENT=5.0
DQ_FAIL_ON_ERROR=false

TIKI_API_BASE=https://tiki.vn/api/v2
CRAWLER_RATE_LIMIT=1.0
CRAWLER_MAX_WORKERS=8
CRAWLER_TIMEOUT=30
# Backend Databricks source (never use VITE_ for the token).
# LAKEHOUSE_DATA_SOURCE only selects the default READ source for browsing.
LAKEHOUSE_DATA_SOURCE=databricks
# Where ETL/ELT mutations execute. This is independent of the read source:
#   local_delta_minio — Spark jobs write Delta into MinIO (the provisioned target).
#   databricks_uc    — reserved for a remote Databricks Jobs pipeline (not implemented).
LAKEHOUSE_EXECUTION_TARGET=local_delta_minio
# DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
# DATABRICKS_TOKEN=replace-with-rotated-token
# DATABRICKS_WORKSPACE_ID=your-workspace-id
# DATABRICKS_WAREHOUSE_ID=your-warehouse-id
# DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/your-warehouse-id
DATABRICKS_CATALOG=workspace
DATABRICKS_BRONZE_SCHEMA=bronze
DATABRICKS_SILVER_SCHEMA=silver
DATABRICKS_GOLD_SCHEMA=gold

DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_WORKSPACE_ID=0000000000000000
DATABRICKS_WAREHOUSE_ID=yourwarehouseid
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/yourwarehouseid
DATABRICKS_TOKEN=replace-with-rotated-token
# Airflow Fernet key — 32 bytes base64-url (44 ký tự, kết thúc bằng "=").
# Giá trị dưới đây chỉ là ví dụ công khai — HÃY TỰ SINH:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# GIÁ TRỊ MẪU — hãy tự sinh khóa riêng trước khi dùng thật:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Khóa này chỉ để Compose khởi động được ngay trên máy mới.
AIRFLOW_FERNET_KEY=UkVQTEFDRV9tZV93aXRoX3lvdXJfb3duXzMyYnl0ZV8=
