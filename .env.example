# Databricks credentials — DO NOT COMMIT real values.
# Copy this file to .env and fill in real secrets:
#   cp .env.example .env
#
# Then either:
#   source .env                              # exports into current shell
#   python -m dotenv .env python scripts/.. # auto-load via python-dotenv
#   direnv allow                             # if using direnv

# Workspace URL (Databricks workspace origin)
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com

# Personal Access Token from User Settings → Developer → Access Tokens
DATABRICKS_TOKEN=replace-with-rotated-token

# SQL Warehouse ID (Settings → SQL Warehouses → click warehouse → copy ID)
DATABRICKS_WAREHOUSE_ID=yourwarehouseid

# Airflow crawler landing target (Unity Catalog Volume -> Bronze Delta table)
DATABRICKS_CATALOG=workspace
DATABRICKS_BRONZE_SCHEMA=bronze
DATABRICKS_BRONZE_VOLUME="bronze_data"
DATABRICKS_CRAWLER_BRONZE_TABLE="crawler_raw"

# Optional: All-Purpose Cluster ID (Compute → click cluster → copy ID)
# Only needed if you run scripts/_etl_pipeline.py / _elt_pipeline.py on a cluster
# instead of the SQL warehouse.
DATABRICKS_CLUSTER_ID=""

# ═══════════════════════════════════════════════════════════════════════════
# Cloudflare R2 (S3-compatible object storage)
# ═══════════════════════════════════════════════════════════════════════════
# QUAN TRỌNG: đây là các biến MÀ CODE THỰC SỰ ĐỌC. Code đọc `S3_*`, KHÔNG
# đọc `R2_*`. Điền `R2_ENDPOINT_URL` / `R2_ACCESS_KEY_ID` / `R2_SECRET_ACCESS_KEY`
# sẽ không có tác dụng gì — hệ thống sẽ mặc định về MinIO local (localhost:9000).
#
#   - `src/lakehouse/core/spark.py`   → _get_s3a_configs(): S3_ENDPOINT, S3_ACCESS_KEY,
#                                        S3_SECRET_KEY, S3_REGION, S3_USE_SSL,
#                                        S3_PATH_STYLE_ACCESS
#   - `apps/api/src/config/env.ts`    → S3_* (fallback về MINIO_* khi không có S3_ENDPOINT)
#   - `scripts/test_r2_connection.sh` → S3_ENDPOINT, S3_ACCESS_KEY, S3_SECRET_KEY
#
# Muốn dùng R2: bỏ comment 6 dòng S3_* bên dưới và điền giá trị thật.
# Muốn dùng MinIO local: giữ nguyên MINIO_* và để S3_* ở dạng comment.
#
#   S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
#   S3_ACCESS_KEY=<R2 access key id>
#   S3_SECRET_KEY=<R2 secret access key>
#   S3_REGION=auto
#   S3_USE_SSL=true
#   S3_PATH_STYLE_ACCESS=true
#   S3_HEALTH_BUCKET=lakehouse
#
# Yêu cầu bucket trên R2: tạo đúng 1 bucket tên `lakehouse` (Object Read & Write).
# Toàn bộ đường dẫn là `s3a://lakehouse/{layer}/{database}/{table}` — KHÔNG phải
# `s3a://bronze/...`. Xem docs/operations/R2_SETUP.md.

ENV=local
LOG_LEVEL=info
# Local PostgreSQL reporting mirror used by Metabase (development only).
GOLD_POSTGRES_USER=metabase
GOLD_POSTGRES_PASSWORD=change-me-local
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
# Canonical bucket that holds every medallion layer.
# Toàn bộ đường dẫn là s3a://lakehouse/{layer}/{database}/{table}.
# minio-init KHÔNG tạo bucket này — phải tạo thủ công (xem README mục 16.2).
LAKEHOUSE_BUCKET=lakehouse
KAFKA_BOOTSTRAP=localhost:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
# MongoDB bật auth (root: mongoadmin/mongoadmin, xem docker-compose.yml).
# Dùng khi chạy API/worker trên HOST (ngoài Docker) — cần authSource=admin.
# Khi chạy trong Docker, docker-compose.dev-api.yml tự override thành
# mongodb://mongoadmin:mongoadmin@mongo:27017/?authSource=admin
MONGO_URI=mongodb://mongoadmin:mongoadmin@localhost:27017/?authSource=admin
MONGO_DB=lakehouse_catalog
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
AIRFLOW_BASE_URL=http://localhost:8088/api/v1
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=admin
API_PORT=3001
API_RATE_LIMIT_PER_MIN=600
API_CORS_ORIGINS=http://localhost:5173,http://localhost:3001
API_SWAGGER_ENABLED=true
DUCKDB_MEMORY_LIMIT=4GB
DUCKDB_THREADS=4
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=2g
SPARK_EXECUTOR_MEMORY=2g
DELTA_PACKAGE=io.delta:delta-spark_2.12:3.0.0
KAFKA_PACKAGE=org.apache.spark:spark-sql-kafka-0-10_2.12:3.4.0
DQ_MAX_NULL_PERCENT=5.0
DQ_FAIL_ON_ERROR=false
TIKI_API_BASE=https://tiki.vn/api/v2
CRAWLER_RATE_LIMIT=1.0
CRAWLER_MAX_WORKERS=8
CRAWLER_TIMEOUT=30
LAKEHOUSE_DATA_SOURCE=databricks
DATABRICKS_WORKSPACE_ID=0000000000000000
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/yourwarehouseid
DATABRICKS_CATALOG=workspace
DATABRICKS_BRONZE_SCHEMA=bronze
DATABRICKS_SILVER_SCHEMA=silver
DATABRICKS_GOLD_SCHEMA=gold
# Airflow Fernet key — BẮT BUỘC, docker-compose sẽ refuse to start nếu thiếu.
# Format: 32 bytes base64-url (44 ký tự, kết thúc bằng "=").
# Giá trị dưới đây chỉ là ví dụ công khai — HÃY TỰ SINH:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   # hoặc: python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# GIÁ TRỊ MẪU — hãy tự sinh khóa riêng trước khi dùng thật:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Khóa này chỉ để Compose khởi động được ngay trên máy mới.
AIRFLOW_FERNET_KEY=UkVQTEFDRV9tZV93aXRoX3lvdXJfb3duXzMyYnl0ZV8=

# Metabase API access (optional; never commit a real API key)
METABASE_URL=http://localhost:3000
METABASE_API_KEY=

# Metabase admin account, used by scripts/seed_metabase_dashboard.py to
# (re)build the "Tổng quan Lakehouse" dashboard. Change the password in the
# Metabase UI, then keep this value in the ignored local .env only.
METABASE_USER=duviet720@gmail.com
METABASE_PASSWORD=
